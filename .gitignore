# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Generated RAG data and local datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vector_store/

# Logs and temporary files
*.log
*.tmp
*.swp

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
